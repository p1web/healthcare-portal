# Frontend Environment Example

# API base URL (pointing to backend service)
NG_APP_API_URL=http://localhost:3000/api

# Application environment
NG_APP_ENV=development

# Analytics key (if using Google Analytics or similar)
NG_APP_ANALYTICS_KEY=your-analytics-key-here

# Feature flags (example)
NG_APP_ENABLE_FEATURE_X=false
NG_APP_ENABLE_FEATURE_Y=true
